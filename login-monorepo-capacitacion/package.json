{
  "name": "login-monorepo-capacitacion",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de practica para CI/CD y pruebas E2E con Playwright.",
  "workspaces": [
    "apps/web",
    "tests/e2e"
  ],
  "scripts": {
    "start:web": "npm --workspace apps/web run start",
    "build:web": "npm --workspace apps/web run build",
    "validate:web": "npm --workspace apps/web run validate",
    "test:e2e": "npm --workspace tests/e2e run test",
    "test:e2e:headed": "npm --workspace tests/e2e run test:headed",
    "test:e2e:ui": "npm --workspace tests/e2e run test:ui",
    "ci": "npm run validate:web && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  }
}
